OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/db
STORAGE_BACKEND=s3
# Any S3-compatible endpoint: Cloudflare R2, Supabase Storage, Backblaze B2, etc.
# R2:       https://<accountid>.r2.cloudflarestorage.com      (S3_REGION=auto)
# Supabase: https://<project-ref>.supabase.co/storage/v1/s3   (S3_REGION=<project region>)
R2_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
R2_BUCKET=aethermind
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_REGION=auto
JWT_SECRET=
JWT_EXPIRE_HOURS=12
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_API_URL=http://localhost:8000
CLASSIFIER_MODEL=gpt-4o-mini
PIPELINE_CONCURRENCY=5
PIPELINE_STAGE_TIMEOUT=60
MCP_API_TOKEN=
MCP_SERVICE_ROLE=reviewer
