OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/db
STORAGE_BACKEND=s3
LEARNING_ENABLED=true
LEARNING_MAX_HINTS_PER_FIELD=3
LEARNING_MAX_HINTS=20
# Schema-Author: auto-propose a schema when a document matches no approved schema (default true)
SCHEMA_AUTHOR_ENABLED=true
# Auto-approve (STP): global kill-switch for straight-through processing. Default OFF; even when
# true, a document type only auto-approves if an admin has opted it in with a confidence floor >0.9.
AUTO_APPROVE_ENABLED=false
# Observability: structured JSON logs (set "plain" for human-readable local logs)
LOG_FORMAT=json
# System-health thresholds (admin /admin/metrics + Health screen)
STUCK_PROCESSING_MINUTES=15
METRICS_RECENT_N=200
# Tenant isolation: the org id existing data/users are bound to (migration 0009 seeds org 1)
DEFAULT_ORG_ID=1
# Any S3-compatible endpoint: Cloudflare R2, Supabase Storage, Backblaze B2, etc.
# R2:       https://<accountid>.r2.cloudflarestorage.com      (S3_REGION=auto)
# Supabase: https://<project-ref>.supabase.co/storage/v1/s3   (S3_REGION=<project region>)
R2_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
R2_BUCKET=aethermind
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_REGION=auto
JWT_SECRET=
JWT_EXPIRE_HOURS=12
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_API_URL=http://localhost:8000
CLASSIFIER_MODEL=gpt-4o-mini
PIPELINE_CONCURRENCY=5
PIPELINE_STAGE_TIMEOUT=60
MCP_API_TOKEN=
MCP_SERVICE_ROLE=reviewer
