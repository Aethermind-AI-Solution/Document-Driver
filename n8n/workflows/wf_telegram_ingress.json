{
  "name": "wf_telegram_ingress",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -860,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "__REPLACE_TELEGRAM_CREDENTIAL_ID__",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message.text }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-text-message",
      "name": "If Text Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -640,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOOKING_CORE_BASE_URL + '/v1/inbound/telegram' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-correlation-id",
              "value": "={{ $execution.id + '-' + $json.message.message_id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ {\n  chat_id: String($json.message.chat.id),\n  message_id: String($json.message.message_id),\n  text: $json.message.text,\n  timestamp: $json.message.date ? new Date($json.message.date * 1000).toISOString() : new Date().toISOString(),\n  raw_payload: $json\n} }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "http-inbound",
      "name": "POST /v1/inbound/telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        20
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOOKING_CORE_BASE_URL + '/v1/session/advance' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-correlation-id",
              "value": "={{ $json.correlation_id || ($execution.id + '-' + $('Telegram Trigger').first().json.message.message_id) }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ {\n  chat_id: String($('Telegram Trigger').first().json.message.chat.id),\n  message_id: String($('Telegram Trigger').first().json.message.message_id),\n  user_text: $('Telegram Trigger').first().json.message.text\n} }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "http-session-advance",
      "name": "POST /v1/session/advance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        20
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.next_action.kind }}",
                    "rightValue": "ASK_USER",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.next_action.kind }}",
                    "rightValue": "DONE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.next_action.kind }}",
                    "rightValue": "RUN_TOOL",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      },
      "id": "switch-action-kind",
      "name": "Switch Action Kind",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        20,
        20
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
        "text": "={{ $json.reply_text || $json.next_action.reply_text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "send-ask",
      "name": "Send ASK_USER Reply",
