        "mode": "runOnceForEachItem",
        "jsCode": "const fallback = $('Execute Workflow Trigger').first().json;\nconst correlationId = fallback.tool_request?.correlation_id || fallback.correlation_id || '';\nconst chatId = fallback.next_action?.payload?.chat_id || fallback.tool_request?.payload?.chat_id || '';\nreturn [{\n  json: {\n    correlation_id: correlationId,\n    tool_name: fallback.next_action?.tool || fallback.tool_request?.tool || 'CALENDAR_CHECK',\n    chat_id: chatId,\n    tool_output: { success: false, error: $json.error?.message || 'Calendar node failure' }\n  }\n}];"
      },
