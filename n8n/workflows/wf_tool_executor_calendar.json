      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "__REPLACE_GCAL_CREDENTIAL_ID__",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const events = $input.all().map((item) => item.json);\nconst busy = [];\nfor (const event of events) {\n  const start = event?.start?.dateTime || event?.start;\n  if (typeof start === 'string') busy.push(new Date(start).toISOString());\n}\nreturn [{\n  json: {\n    correlation_id: $('Execute Workflow Trigger').first().json.tool_request?.correlation_id || $('Execute Workflow Trigger').first().json.correlation_id,\n    chat_id: $('Execute Workflow Trigger').first().json.next_action?.payload?.chat_id || $('Execute Workflow Trigger').first().json.tool_request?.payload?.chat_id,\n    tool_name: 'CALENDAR_CHECK',\n    tool_output: { success: true, busy_slots_utc: busy }\n  }\n}];"
      },
      "id": "build-check-result",
      "name": "Build CALENDAR_CHECK Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GCAL_CALENDAR_ID }}"
        },
        "start": "={{ $json.next_action.payload.start_utc || $json.tool_request.payload.start_utc }}",
        "end": "={{ $json.next_action.payload.end_utc || $json.tool_request.payload.end_utc }}",
        "additionalFields": {
          "summary": "={{ $json.next_action.payload.summary || $json.tool_request.payload.summary }}"
        }
      },
      "id": "calendar-create",
      "name": "Google Calendar Create",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [
        -400,
        40
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "__REPLACE_GCAL_CREDENTIAL_ID__",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const eventId = $json?.id || $json?.eventId || null;\nreturn [{\n  json: {\n    correlation_id: $('Execute Workflow Trigger').first().json.tool_request?.correlation_id || $('Execute Workflow Trigger').first().json.correlation_id,\n    chat_id: $('Execute Workflow Trigger').first().json.next_action?.payload?.chat_id || $('Execute Workflow Trigger').first().json.tool_request?.payload?.chat_id,\n    tool_name: 'CALENDAR_CREATE',\n    tool_output: { success: Boolean(eventId), event_id: eventId, raw: $json }\n  }\n}];"
      },
      "id": "build-create-result",
      "name": "Build CALENDAR_CREATE Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
